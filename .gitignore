# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables and secrets
.env
*.env
.secret*
!/.secrets.baseline
client_secret*.json
oauth*.json
credentials*.json
secrets.json
secrets.yaml
*.secret
*.secrets
!/.secrets.baseline

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Testing and linting caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebook checkpoints
.ipynb_checkpoints/

# MLflow / Experiment tracking
mlruns/
wandb/

# Data and Models: NEVER commit raw data or model weights to Git
# (These are tracked via DVC in data/*.dvc and models/*.dvc)
# Keep parent directories visible so DVC can discover the raw pointer on Windows.
# Local data rules live in data/.gitignore.
models/
*.csv
*.xlsx
*.parquet
*.pkl
*.joblib
*.onnx
*.pt
*.h5

# DVC local configs and caches
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# Local verification outputs
artifacts/
tmp/
